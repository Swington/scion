# Private-LB overlay — optional environment overrides
#
# Every value here has a sensible default in config.sh; you only need
# this file to override one. Source it before running the overlay scripts:
#
#   set -a; source scripts/starter-hub/private-lb/env.sample; set +a
#   scripts/starter-hub/private-lb/deploy.sh
#
# This file MUST NOT contain secrets. OAuth client IDs/secrets are read from
# Google Secret Manager at deploy time by hubenv.sh — never from here.

# --- Identity ---
# HUB_NAME=hub
# PROJECT_ID=your-project                 # defaults to `gcloud config get-value project`
# REGION=us-central1
# ZONE=us-central1-a

# --- Domain / DNS ---
# HUB_DOMAIN=scion.hub.example.com       # served hostname == managed-cert domain
# DNS_ZONE_NAME=scion-hub-example-com    # existing Cloud DNS managed zone

# --- Custom VPC / private VM ---
# NETWORK=scion-network
# SUBNET=scion-subnet
# SUBNET_RANGE=10.0.0.0/20
# VM_EXTERNAL_IP=false                   # private VM; egress via Cloud NAT
# MACHINE_TYPE=e2-standard-4

# --- Load balancer (LB re-encrypts to Caddy on the VM — "double TLS") ---
# ENABLE_LB=true
# HUB_PORT=8080
# LB_BACKEND_PROTOCOL=HTTPS               # how the LB reaches Caddy on the VM
# LB_BACKEND_PORT=443
# LB_HC_PORT=8080                         # health check hits the hub directly

# --- Agent runtime ---
# ENABLE_GKE=false                       # Docker containers on the hub VM (no GKE)

# --- Admin console ---
# HUB_ADMIN_EMAILS=admin@example.com            # comma-separated; -> settings.yaml
#                                               # server.hub.admin_emails (admin role
#                                               # on OAuth login → admin console visible)

# --- Telemetry service account ---
# TELEMETRY_KEYLESS=false                # true = create SA + roles but no JSON key
#                                        # (consumed via ADC). Auto-enabled anyway if
#                                        # the org policy forbids SA key creation.

# --- Hub image registry (non-secret) ---
# SCION_IMAGE_REGISTRY=us-central1-docker.pkg.dev/your-project/scion/scion

# --- Secret Manager secret names (override only if yours differ) ---
# WEB_ID_SECRET_NAME=scion-hub-oauth-web-client-id
# WEB_SECRET_SECRET_NAME=scion-hub-oauth-web-client-secret
# CLI_ID_SECRET_NAME=scion-hub-oauth-cli-client-id
# CLI_SECRET_SECRET_NAME=scion-hub-oauth-cli-client-secret
